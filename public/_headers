/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=86400

/favicon*
  Cache-Control: no-cache, no-store, must-revalidate

/apple-touch-icon*
  Cache-Control: no-cache, no-store, must-revalidate
