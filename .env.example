# ImageAlchemy browser configuration.
# Copy to .env.local for local development.
#
# SECURITY: every VITE_* value is public because Vite embeds it in the browser
# bundle. Never put Stripe secret keys, webhook secrets, signing secrets, or
# legacy licence secrets here. Server secrets belong in Cloudflare Worker
# secrets; see docs/STRIPE-SETUP.md.

# Public URL of the Cloudflare Worker in workers/audit-proxy.
# The same Worker creates Stripe Checkout Sessions, verifies paid sessions,
# issues Pro entitlement tokens, and runs authenticated website audits.
VITE_PRO_API_URL=https://imagealchemy-audit-proxy.YOUR-SUBDOMAIN.workers.dev
VITE_AUDIT_PROXY_URL=https://imagealchemy-audit-proxy.YOUR-SUBDOMAIN.workers.dev

# Display-only values. The Worker independently verifies the real Stripe Price
# ID before issuing an entitlement, so changing these cannot unlock Pro.
VITE_PRO_PRICE_DISPLAY=$19
VITE_PRO_PRODUCT_ID=pro_lifetime
