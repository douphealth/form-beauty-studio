# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# Vite inlines every VITE_* variable into the client bundle, so NOTHING here is
# secret. That is expected and is why the threat model in src/lib/pro.ts is
# written the way it is. See docs/STRIPE-SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stripe ───────────────────────────────────────────────────────────────────
# Stripe Dashboard → Payment links → New → one-time price → copy the link.
VITE_STRIPE_CHECKOUT_URL=https://buy.stripe.com/REPLACE_ME

# Shown on the paywall. Must match the price on the Payment Link above.
VITE_PRO_PRICE_DISPLAY=$19

# Product identifier passed through to Stripe metadata, so a purchase can be
# traced back to the tier it unlocked.
VITE_PRO_PRODUCT_ID=pro_lifetime

# ── Licence keys ─────────────────────────────────────────────────────────────
# The shared secret used to sign and verify licence keys OFFLINE.
# Generate one:  openssl rand -base64 32
# Change it and every previously issued key stops working — so set it once and
# keep it. If you rotate it, re-issue keys for existing customers.
VITE_PRO_LICENCE_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# ── Website Image Audit ──────────────────────────────────────────────────────
# The Cloudflare Worker that fetches audited pages. See workers/audit-proxy/.
VITE_AUDIT_PROXY_URL=https://imagealchemy-audit-proxy.YOUR-SUBDOMAIN.workers.dev

# Shared token sent to the Worker as `x-audit-token`. Must match the value you
# set with `npx wrangler secret put AUDIT_TOKEN` in workers/audit-proxy/.
# Public by definition (it ships in the bundle) — it raises the bar from "anyone
# with the URL" to "anyone who reads the JS", which is the honest ceiling here.
# The Worker's per-IP rate limiter is the control that actually matters.
VITE_AUDIT_TOKEN=REPLACE_WITH_A_RANDOM_STRING
